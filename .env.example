# ============================================================
# TIMBA PREDICTOR - Plantilla de Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores:
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
# ============================================================

# --- FLASK (Obligatoria para producción) ---
# Genera una clave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_segura_en_produccion

# --- FOOTBALL DATA API (Opcional) ---
# Requerida para marcadores en vivo reales (run_live.py / /live)
# Obtén tu API key gratis en: https://www.football-data.org/
FOOTBALL_DATA_API_KEY=

# --- TELEGRAM BOT (Opcional) ---
# Requerida únicamente para ejecutar bot.py
# Crea un bot con @BotFather en Telegram y pega el token aquí:
TELEGRAM_BOT_TOKEN=

# --- FRONTEND NEXT.JS (Opcional en desarrollo local) ---
API_INTERNAL_URL=http://127.0.0.1:5000
NEXT_PUBLIC_SITE_URL=https://futbol-predicciones.xyz


# ============================================================
# NOTAS:
# - Sin estas claves, la web y las predicciones pre-partido
#   funcionan igualmente usando datos históricos y feeds públicos.
# ============================================================
