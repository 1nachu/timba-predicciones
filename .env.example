# ============================================================
# TIMBA PREDICTOR - Plantilla de Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env
# ============================================================

# --- FLASK (Obligatoria para producción) ---
# Genera una clave segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_segura_en_produccion

# --- FOOTBALL DATA API (Opcional) ---
# Requerida para funcionalidad de partidos en vivo
# Obtén tu API key gratis en: https://www.football-data.org/
FOOTBALL_DATA_API_KEY=

# --- API FOOTBALL LEGACY (Opcional) ---
# API key alternativa para funciones legacy en timba_core
API_FOOTBALL_KEY=

# ============================================================
# NOTAS:
# - Sin estas claves, la app funcionará pero algunas features
#   estarán limitadas (live scores mostrará datos de demo)
# - SECRET_KEY tiene un default inseguro para desarrollo
# ============================================================
